# MongoDB Connection String
# For local development:
MONGO_URI=mongodb://localhost:27017/parikshax

# For MongoDB Atlas (production):
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/parikshax?retryWrites=true&w=majority

# Server Port
PORT=5000

# Secret key for report signing (CHANGE THIS IN PRODUCTION!)
# Generate a secure random key: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REPORT_SECRET=change-this-to-a-secure-random-key-in-production

# JWT Secret (for future authentication)
# JWT_SECRET=your-jwt-secret-here

# Environment
NODE_ENV=development

# CORS Origin (frontend URL)
CORS_ORIGIN=http://localhost:5173

# Data Retention (days)
DATA_RETENTION_DAYS=90
