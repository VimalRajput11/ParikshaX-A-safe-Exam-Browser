# MongoDB Connection String
# For local development:
MONGO_URI=mongodb://localhost:27017/parikshax

# For MongoDB Atlas (production):
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/parikshax?retryWrites=true&w=majority

# Server Port
PORT=5000

# Secret key for report signing (CHANGE THIS IN PRODUCTION!)
# Generate a secure random key: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REPORT_SECRET=change-this-to-a-secure-random-key-in-production

# JWT Secret (for future authentication)
# JWT_SECRET=your-jwt-secret-here

# Environment
NODE_ENV=development

# Extra allowed CORS origins, comma-separated (localhost + parikshax.vercel.app are built in)
# CORS_ORIGIN=https://your-custom-domain.com,https://your-preview.vercel.app

# Data Retention (days)
DATA_RETENTION_DAYS=90

# Email (Nodemailer) - use a Gmail App Password for EMAIL_PASS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
EMAIL_USER=
EMAIL_PASS=
BROWSER_DOWNLOAD_URL=

# NOTE: on Vercel, set these in Project Settings > Environment Variables (NODE_ENV/VERCEL are set automatically)
